# Plex Burner settings for Docker Compose.
# Copy to .env (cp .env.example .env), edit, then: docker compose up -d
# .env is not tracked by git, so in-app updates never overwrite your settings.
#
# Save locations, the output format, auto-start and eject are set in the app.

# Port for the dashboard.
PORT=9000

# Your media folder on the server. Plex Burner can browse and save anywhere inside it.
MEDIA_PATH=/srv/media
# A second folder it may use, for example where network shares or extra drives are mounted.
EXTRA_PATH=/mnt

# Owner given to copied files. Run `id` on the server to see your numbers.
PUID=1000
PGID=1000

# Only use these drives (comma separated, for example sr0,sr1). Empty uses every drive, found automatically.
DISC_DEVICES=

# Updates: check GitHub every N hours, and optionally install new versions automatically.
UPDATE_CHECK_HOURS=6
AUTO_UPDATE=false

TZ=Europe/London
